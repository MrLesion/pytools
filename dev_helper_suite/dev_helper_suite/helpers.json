{
  "version": 1,
  "helpers": [
    {
      "id": "smoke-checker",
      "name": "Website smoke checker",
      "script_path": "helpers/smoke_checker.py",
      "description": "Check HTTP status, final URL, response time and expected text in server HTML. JavaScript is not executed.",
      "example_use": "After a deployment, check your homepage, product page and checkout entry URL.",
      "code_example": "python cli.py smoke-checker --input examples/smoke-checker.json\n\n# JSON inputs\n{\n  \"urls\": [\n    \"https://example.com\"\n  ],\n  \"expected_status\": 200,\n  \"expected_text\": \"Example Domain\",\n  \"timeout\": 15\n}",
      "fields": [
        {
          "name": "urls",
          "label": "URLs (one per line)",
          "type": "multiline",
          "default": "https://example.com",
          "required": true
        },
        {
          "name": "expected_status",
          "label": "Expected status",
          "type": "int",
          "default": 200
        },
        {
          "name": "expected_text",
          "label": "Expected text",
          "type": "text",
          "default": ""
        },
        {
          "name": "timeout",
          "label": "Timeout per URL (seconds)",
          "type": "float",
          "default": 15
        }
      ]
    },
    {
      "id": "log-investigator",
      "name": "Log investigator",
      "script_path": "helpers/log_investigator.py",
      "description": "Group warning and error records from .NET/plain-text or JSON logs. Preserve multiline stack traces and normalize numeric IDs for grouping.",
      "example_use": "Find the most frequent exceptions in an IIS application log folder.",
      "code_example": "python cli.py log-investigator --input examples/log-investigator.json\n\n# JSON inputs\n{\n  \"path\": \"examples/sample.log\"\n}",
      "fields": [
        {
          "name": "path",
          "label": "Log file or folder",
          "type": "path",
          "default": "examples/sample.log",
          "required": true
        }
      ]
    },
    {
      "id": "tracking-inspector",
      "name": "Tracking inspector",
      "script_path": "helpers/tracking_inspector.py",
      "description": "Inspect saved dataLayer events or capture a fresh Chromium session. Validate ecommerce fields and flag potential duplicate product views. Browser capture requires Playwright.",
      "example_use": "Leave Source file empty, enter a product URL, and interact with the browser during capture. Or inspect the included sample offline. This checks dataLayer, not GA4 delivery.",
      "code_example": "python cli.py tracking-inspector --input examples/tracking-inspector.json\n\n# JSON inputs\n{\n  \"source\": \"examples/tracking.json\"\n}",
      "fields": [
        {
          "name": "source",
          "label": "Saved events JSON (optional)",
          "type": "file",
          "default": "examples/tracking.json"
        },
        {
          "name": "url",
          "label": "URL for browser capture",
          "type": "text",
          "default": "https://example.com"
        },
        {
          "name": "capture_seconds",
          "label": "Capture duration (seconds)",
          "type": "int",
          "default": 20
        },
        {
          "name": "show_browser",
          "label": "Show interactive browser",
          "type": "bool",
          "default": true
        }
      ]
    },
    {
      "id": "feed-auditor",
      "name": "Product feed auditor",
      "script_path": "helpers/feed_auditor.py",
      "description": "Validate JSON, CSV or XML product feeds for required IDs/names, duplicate IDs, prices, currency and image URL syntax. Map your feed fields below.",
      "example_use": "Audit an exported Google Merchant XML feed with xml_item=item, or a JSON API export with items_path=data.products.",
      "code_example": "python cli.py feed-auditor --input examples/feed-auditor.json\n\n# JSON inputs\n{\n  \"source\": \"examples/products.json\"\n}",
      "fields": [
        {
          "name": "source",
          "label": "File or HTTP(S) URL",
          "type": "file",
          "default": "examples/products.json",
          "required": true
        },
        {
          "name": "format",
          "label": "Format",
          "type": "select",
          "default": "auto",
          "options": [
            "auto",
            "json",
            "csv",
            "xml"
          ]
        },
        {
          "name": "items_path",
          "label": "JSON items path",
          "type": "text",
          "default": ""
        },
        {
          "name": "xml_item",
          "label": "XML item tag",
          "type": "text",
          "default": "item"
        },
        {
          "name": "delimiter",
          "label": "CSV delimiter",
          "type": "text",
          "default": ","
        },
        {
          "name": "id_field",
          "label": "ID field",
          "type": "text",
          "default": "id"
        },
        {
          "name": "name_field",
          "label": "Name field",
          "type": "text",
          "default": "title"
        },
        {
          "name": "price_field",
          "label": "Price field",
          "type": "text",
          "default": "price"
        },
        {
          "name": "currency_field",
          "label": "Currency field",
          "type": "text",
          "default": "currency"
        },
        {
          "name": "image_field",
          "label": "Image field",
          "type": "text",
          "default": "image_link"
        }
      ]
    },
    {
      "id": "test-data-generator",
      "name": "Test data generator",
      "script_path": "helpers/test_data_generator.py",
      "description": "Generate deterministic synthetic products, customers or orders. Order mode includes linked customer/product tables. Export the result as JSON.",
      "example_use": "Create 100 sample orders with valid customer/product references using a fixed seed for reproducibility.",
      "code_example": "python cli.py test-data-generator --input examples/test-data-generator.json\n\n# JSON inputs\n{\n  \"kind\": \"orders\",\n  \"count\": 10,\n  \"seed\": 42\n}",
      "fields": [
        {
          "name": "kind",
          "label": "Record type",
          "type": "select",
          "default": "products",
          "options": [
            "products",
            "customers",
            "orders"
          ]
        },
        {
          "name": "count",
          "label": "Record count (1\u201310000)",
          "type": "int",
          "default": 10
        },
        {
          "name": "seed",
          "label": "Random seed",
          "type": "int",
          "default": 42
        }
      ]
    },
    {
      "id": "api-comparer",
      "name": "API response comparer",
      "script_path": "helpers/api_comparer.py",
      "description": "Compare local JSON files or HTTP GET responses. Ignore fields, match object arrays by ID and apply an absolute numeric tolerance. Duplicate array IDs are reported as input errors.",
      "example_use": "Compare staging/production product responses while ignoring updatedAt and matching products by id. Headers are sent to both URLs; use only endpoints you trust.",
      "code_example": "python cli.py api-comparer --input examples/api-comparer.json\n\n# JSON inputs\n{\n  \"left\": \"examples/api-left.json\",\n  \"right\": \"examples/api-right.json\",\n  \"array_key\": \"id\",\n  \"ignore\": [\n    \"updatedAt\"\n  ],\n  \"tolerance\": 0\n}",
      "fields": [
        {
          "name": "left",
          "label": "Left file or URL",
          "type": "file",
          "default": "examples/api-left.json",
          "required": true
        },
        {
          "name": "right",
          "label": "Right file or URL",
          "type": "file",
          "default": "examples/api-right.json",
          "required": true
        },
        {
          "name": "array_key",
          "label": "Array identity field",
          "type": "text",
          "default": "id"
        },
        {
          "name": "ignore",
          "label": "Ignored fields (comma separated)",
          "type": "text",
          "default": "updatedAt"
        },
        {
          "name": "tolerance",
          "label": "Absolute numeric tolerance",
          "type": "float",
          "default": 0
        },
        {
          "name": "headers",
          "label": "HTTP headers (JSON object)",
          "type": "json",
          "default": {}
        }
      ]
    },
    {
      "id": "json-validator",
      "name": "JSON validator",
      "script_path": "helpers/json_validator.py",
      "description": "Validate JSON syntax with line/column diagnostics, duplicate-key checks and optional formatting. Accepts pasted content, HTTP(S) URLs or files. No JSON Schema validation.",
      "example_use": "Paste an API response and click Run helper. To fetch a document, select url mode and enter its HTTP(S) address. Only the selected input mode is read.",
      "code_example": "python cli.py json-validator --input examples/json-validator.json\n\n# Pasted content\n{\n  \"mode\": \"input\",\n  \"content\": \"{\\n  \\\"id\\\": \\\"P001\\\",\\n  \\\"price\\\": 149.95\\n}\"\n}\n\n# URL mode\n{\n  \"mode\": \"url\",\n  \"url\": \"https://example.com/data.json\"\n}",
      "fields": [
        {
          "name": "mode",
          "label": "Input mode",
          "type": "select",
          "default": "input",
          "options": [
            "input",
            "url",
            "file"
          ]
        },
        {
          "name": "content",
          "label": "Paste JSON content",
          "type": "multiline",
          "default": "{\n  \"id\": \"P001\",\n  \"price\": 149.95\n}"
        },
        {
          "name": "url",
          "label": "URL (URL mode only)",
          "type": "text",
          "default": ""
        },
        {
          "name": "path",
          "label": "File (file mode only)",
          "type": "file",
          "default": ""
        },
        {
          "name": "timeout",
          "label": "HTTP timeout (seconds)",
          "type": "float",
          "default": 20
        },
        {
          "name": "format_output",
          "label": "Include formatted JSON",
          "type": "bool",
          "default": true
        }
      ]
    },
    {
      "id": "xml-validator",
      "name": "XML validator",
      "script_path": "helpers/xml_validator.py",
      "description": "Validate XML well-formedness with line/column diagnostics and element statistics. Accepts pasted content, HTTP(S) URLs or files. DTDs and XSD validation are not supported.",
      "example_use": "Paste an API response and click Run helper. To fetch a document, select url mode and enter its HTTP(S) address. Only the selected input mode is read.",
      "code_example": "python cli.py xml-validator --input examples/xml-validator.json\n\n# Pasted content\n{\n  \"mode\": \"input\",\n  \"content\": \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\\n<products>\\n  <product id=\\\"P001\\\"><price>149.95</price></product>\\n</products>\"\n}\n\n# URL mode\n{\n  \"mode\": \"url\",\n  \"url\": \"https://example.com/data.xml\"\n}",
      "fields": [
        {
          "name": "mode",
          "label": "Input mode",
          "type": "select",
          "default": "input",
          "options": [
            "input",
            "url",
            "file"
          ]
        },
        {
          "name": "content",
          "label": "Paste XML content",
          "type": "multiline",
          "default": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<products>\n  <product id=\"P001\"><price>149.95</price></product>\n</products>"
        },
        {
          "name": "url",
          "label": "URL (URL mode only)",
          "type": "text",
          "default": ""
        },
        {
          "name": "path",
          "label": "File (file mode only)",
          "type": "file",
          "default": ""
        },
        {
          "name": "timeout",
          "label": "HTTP timeout (seconds)",
          "type": "float",
          "default": 20
        }
      ]
    },
    {
      "id": "uptime-checker",
      "name": "HTTP uptime checker",
      "script_path": "helpers/uptime_checker.py",
      "description": "Pingdom-style HTTP checks with response times, status validation and optional text matching. Follows redirects and verifies TLS certificates.",
      "example_use": "Check your production homepage five times and flag unexpected status codes, missing content or responses exceeding 2000 ms.",
      "code_example": "python helpers/uptime_checker.py --input params.json\n\nExample params.json:\n{\"url\":\"https://example.com\",\"attempts\":5,\"interval\":1,\"timeout\":15,\"expected_status\":200,\"expected_text\":\"Example Domain\",\"max_response_ms\":2000}",
      "fields": [
        {
          "name": "url",
          "label": "Website URL",
          "type": "text",
          "default": "https://example.com",
          "required": true
        },
        {
          "name": "attempts",
          "label": "Samples (1–10)",
          "type": "int",
          "default": 3
        },
        {
          "name": "interval",
          "label": "Pause between samples (0–10 seconds)",
          "type": "float",
          "default": 1
        },
        {
          "name": "timeout",
          "label": "HTTP timeout (1–30 seconds)",
          "type": "float",
          "default": 15
        },
        {
          "name": "expected_status",
          "label": "Expected HTTP status",
          "type": "int",
          "default": 200
        },
        {
          "name": "expected_text",
          "label": "Expected page text (optional)",
          "type": "text",
          "default": ""
        },
        {
          "name": "max_response_ms",
          "label": "Maximum response time in ms (0 disables)",
          "type": "float",
          "default": 2000
        }
      ]
    },
    {
    "id": "razor-template-finder",
    "name": "Razor/template finder",
    "script_path": "helpers/razor_template_finder.py",
    "description": "Search Razor/HTML files and extract literal includes, URLs, field access and translation keys. Skips common dependency/build folders.",
    "example_use": "Choose translations to list Translate(\"key\") calls, or search for a shared partial or custom product field.",
    "code_example": "python cli.py razor-template-finder --input plugin_examples/razor-template-finder.json\n\n{\n  \"root\": \"plugin_examples/templates\",\n  \"mode\": \"translations\"\n}",
    "fields": [
      {
        "name": "root",
        "label": "Template folder",
        "type": "path",
        "default": "plugin_examples/templates",
        "required": true
      },
      {
        "name": "mode",
        "label": "Search mode",
        "type": "select",
        "default": "search",
        "options": [
          "search",
          "translations",
          "includes",
          "urls",
          "fields"
        ]
      },
      {
        "name": "query",
        "label": "Search text / optional extraction filter",
        "type": "text",
        "default": "Product"
      },
      {
        "name": "patterns",
        "label": "Filename patterns",
        "type": "text",
        "default": "*.cshtml,*.razor,*.html"
      }
    ],
    "support_files": [
      "helpers/dev_plugins_support.py"
    ]
  },
  {
    "id": "translation-auditor",
    "name": "Translation auditor",
    "script_path": "helpers/translation_auditor.py",
    "description": "Compare exported translations across languages and optionally check literal template usage. Supports documented JSON, CSV and portable XML formats.",
    "example_use": "Export translations to {\"en\":{\"key\":\"Text\"},\"da\":{\"key\":\"Tekst\"}}. Missing keys and empty values fail; potentially unused keys are warnings.",
    "code_example": "python cli.py translation-auditor --input plugin_examples/translation-auditor.json\n\n{\n  \"source\": \"plugin_examples/translations.json\",\n  \"baseline_language\": \"en\",\n  \"templates_root\": \"plugin_examples/templates\"\n}",
    "fields": [
      {
        "name": "source",
        "label": "Translation export",
        "type": "file",
        "default": "plugin_examples/translations.json",
        "required": true
      },
      {
        "name": "baseline_language",
        "label": "Baseline language",
        "type": "text",
        "default": "en"
      },
      {
        "name": "templates_root",
        "label": "Optional template folder",
        "type": "path",
        "default": "plugin_examples/templates"
      }
    ],
    "support_files": [
      "helpers/dev_plugins_support.py",
      "helpers/razor_template_finder.py"
    ]
  },
  {
    "id": "deployment-config-checker",
    "name": "Deployment configuration checker",
    "script_path": "helpers/deployment_config_checker.py",
    "description": "Check a configuration file against explicit rules. JSON, simple .env and XML appSettings/connectionStrings are supported. Configuration values are omitted from results.",
    "example_use": "Create production rules for debug flags, API hosts and required settings. This checks a file, not merged runtime configuration.",
    "code_example": "python cli.py deployment-config-checker --input plugin_examples/deployment-config-checker.json\n\n{\n  \"config_path\": \"plugin_examples/appsettings.json\",\n  \"environment\": \"production\",\n  \"rules\": [\n    {\n      \"key\": \"Debug\",\n      \"op\": \"equals\",\n      \"value\": false\n    },\n    {\n      \"key\": \"Api.BaseUrl\",\n      \"op\": \"not_contains\",\n      \"value\": \"localhost\"\n    }\n  ]\n}",
    "fields": [
      {
        "name": "config_path",
        "label": "Configuration file",
        "type": "file",
        "default": "plugin_examples/appsettings.json",
        "required": true
      },
      {
        "name": "environment",
        "label": "Environment label",
        "type": "text",
        "default": "production"
      },
      {
        "name": "rules",
        "label": "Rules (JSON array; leave empty to use file)",
        "type": "json",
        "default": [
          {
            "key": "Debug",
            "op": "equals",
            "value": false
          },
          {
            "key": "Api.BaseUrl",
            "op": "not_contains",
            "value": "localhost"
          }
        ]
      },
      {
        "name": "rules_path",
        "label": "Optional rules file",
        "type": "file",
        "default": ""
      }
    ],
    "support_files": [
      "helpers/dev_plugins_support.py"
    ]
  },
  {
    "id": "visual-regression-checker",
    "name": "Visual regression checker",
    "script_path": "helpers/visual_regression_checker.py",
    "description": "Capture a full-page Chromium screenshot and compare pixels with an explicit baseline. Saves actual/baseline/difference PNGs. Baseline mode overwrites that named baseline.",
    "example_use": "Create a baseline in your reference environment, then run compare with the same URL, name and viewport after changes. Mask dynamic content and use the same browser/OS/fonts.",
    "code_example": "python cli.py visual-regression-checker --input plugin_examples/visual-regression-checker.json\n\n{\n  \"url\": \"http://127.0.0.1:8000\",\n  \"mode\": \"baseline\",\n  \"name\": \"homepage\"\n}",
    "fields": [
      {
        "name": "mode",
        "label": "Mode",
        "type": "select",
        "default": "compare",
        "options": [
          "compare",
          "baseline"
        ]
      },
      {
        "name": "name",
        "label": "Snapshot name",
        "type": "text",
        "default": "homepage"
      },
      {
        "name": "url",
        "label": "Page URL",
        "type": "text",
        "default": "http://127.0.0.1:8000",
        "required": true
      },
      {
        "name": "width",
        "label": "Viewport width",
        "type": "int",
        "default": 1440
      },
      {
        "name": "height",
        "label": "Viewport height",
        "type": "int",
        "default": 900
      },
      {
        "name": "timeout",
        "label": "Action/navigation timeout (seconds)",
        "type": "float",
        "default": 15
      },
      {
        "name": "ready_selector",
        "label": "Optional ready selector",
        "type": "text",
        "default": ""
      },
      {
        "name": "output_dir",
        "label": "Snapshot folder",
        "type": "path",
        "default": "plugin_reports/visual"
      },
      {
        "name": "mask_selectors",
        "label": "Mask selectors (JSON array)",
        "type": "json",
        "default": []
      },
      {
        "name": "pixel_threshold",
        "label": "Per-channel pixel threshold (0\u2013255)",
        "type": "int",
        "default": 16
      },
      {
        "name": "allowed_difference_percent",
        "label": "Allowed changed pixels (%)",
        "type": "float",
        "default": 0.1
      }
    ],
    "support_files": [
      "helpers/dev_plugins_support.py"
    ]
  },
  {
    "id": "browser-journey-runner",
    "name": "Browser journey runner",
    "script_path": "helpers/browser_journey_runner.py",
    "description": "Run explicit browser actions and assertions, stopping at the first failure. JSON actions include navigation, filling, clicking and text/count/URL assertions.",
    "example_use": "Use test accounts and a test environment for flows that change data. The included example only checks body visibility/count and does not submit anything.",
    "code_example": "python cli.py browser-journey-runner --input plugin_examples/browser-journey-runner.json\n\n{\n  \"url\": \"http://127.0.0.1:8000\",\n  \"steps\": [\n    {\n      \"action\": \"wait_visible\",\n      \"selector\": \"body\"\n    },\n    {\n      \"action\": \"assert_count\",\n      \"selector\": \"body\",\n      \"value\": 1\n    }\n  ]\n}",
    "fields": [
      {
        "name": "url",
        "label": "Initial URL (optional)",
        "type": "text",
        "default": "http://127.0.0.1:8000"
      },
      {
        "name": "steps",
        "label": "Journey steps (JSON array)",
        "type": "json",
        "default": [
          {
            "action": "wait_visible",
            "selector": "body"
          },
          {
            "action": "assert_count",
            "selector": "body",
            "value": 1
          }
        ],
        "required": true
      },
      {
        "name": "timeout",
        "label": "Action/navigation timeout (seconds)",
        "type": "float",
        "default": 15
      },
      {
        "name": "show_browser",
        "label": "Show browser",
        "type": "bool",
        "default": false
      },
      {
        "name": "fail_on_page_errors",
        "label": "Fail on uncaught JavaScript errors",
        "type": "bool",
        "default": true
      }
    ],
    "support_files": [
      "helpers/dev_plugins_support.py"
    ]
  },
  {
    "id": "accessibility-checker",
    "name": "Accessibility checker",
    "script_path": "helpers/accessibility_checker.py",
    "description": "Run local axe-core against the loaded page. Returns violations, affected selectors, help links and incomplete checks requiring manual review.",
    "example_use": "Install optional browser requirements and axe-core, then audit each important page/state. Automated results are not a WCAG certification.",
    "code_example": "python cli.py accessibility-checker --input plugin_examples/accessibility-checker.json\n\n{\n  \"url\": \"http://127.0.0.1:8000\",\n  \"tags\": [\n    \"wcag2a\",\n    \"wcag2aa\",\n    \"wcag21a\",\n    \"wcag21aa\"\n  ]\n}",
    "fields": [
      {
        "name": "url",
        "label": "Page URL",
        "type": "text",
        "default": "http://127.0.0.1:8000",
        "required": true
      },
      {
        "name": "width",
        "label": "Viewport width",
        "type": "int",
        "default": 1440
      },
      {
        "name": "height",
        "label": "Viewport height",
        "type": "int",
        "default": 900
      },
      {
        "name": "timeout",
        "label": "Action/navigation timeout (seconds)",
        "type": "float",
        "default": 15
      },
      {
        "name": "ready_selector",
        "label": "Optional ready selector",
        "type": "text",
        "default": ""
      },
      {
        "name": "axe_path",
        "label": "Local axe.min.js",
        "type": "file",
        "default": "plugin_vendor/node_modules/axe-core/axe.min.js"
      },
      {
        "name": "tags",
        "label": "Axe rule tags",
        "type": "json",
        "default": [
          "wcag2a",
          "wcag2aa",
          "wcag21a",
          "wcag21aa"
        ]
      }
    ],
    "support_files": [
      "helpers/dev_plugins_support.py"
    ]
  },
  {
    "id": "link-asset-crawler",
    "name": "Link and asset crawler",
    "script_path": "helpers/link_asset_crawler.py",
    "description": "Check bounded same-origin links/assets referenced in server HTML. Reports broken requests and redirects. Excludes JavaScript routes, CSS URLs, srcset and external origins.",
    "example_use": "Start at a staging homepage with a small URL limit. Only crawl routes you intend to request; exclude sites with state-changing GET links.",
